{
  "name": "trpc-multiplex",
  "version": "0.3.1",
  "description": "Run many tRPC subscriptions over one HTTP stream per tab, or per browser through a shared worker",
  "keywords": [
    "multiplex",
    "server-sent-events",
    "shared-worker",
    "sse",
    "subscriptions",
    "trpc"
  ],
  "homepage": "https://github.com/IlyaSemenov/trpc-multiplex#readme",
  "bugs": "https://github.com/IlyaSemenov/trpc-multiplex/issues",
  "license": "MIT",
  "author": "Ilya Semenov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IlyaSemenov/trpc-multiplex.git"
  },
  "files": [
    "README.md",
    "dist"
  ],
  "type": "module",
  "exports": {
    "./client": "./dist/client.mjs",
    "./server": "./dist/server.mjs",
    "./worker": "./dist/worker.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "prepare": "lefthook install",
    "types": "bun check && bun check -p tests && bun check -p e2e",
    "test": "bun test",
    "prepublishOnly": "bun run build",
    "lint": "oxlint --fix && oxfmt",
    "lint:check": "oxlint && oxfmt --check",
    "test:e2e": "bun run build && vite build --config e2e/app/vite.config.ts && playwright test",
    "release": "changesets-local"
  },
  "dependencies": {
    "valibot": "^1.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@changesets/cli": "^3.0.3",
    "@ilyasemenov/oxc-config": "^0.1.3",
    "@playwright/test": "^1.65.1",
    "@trpc/client": "^11.28.3",
    "@trpc/server": "^11.28.3",
    "@tsconfig/bun": "^1.0.12",
    "@types/bun": "^1.4.4",
    "changesets-local": "^1.6.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "publint": "^0.3.25",
    "superjson": "^2.2.6",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "peerDependencies": {
    "@trpc/client": "^11.18.0",
    "@trpc/server": "^11.18.0"
  },
  "packageManager": "bun@1.4.4"
}
